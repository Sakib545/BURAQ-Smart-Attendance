{
  "manifest_version": 3,
  "name": "BURAQ Duty Browsing Tracker",
  "version": "1.0.1",
  "description": "Records website names and time during duty hours for BURAQ Smart Attendance. Nothing is recorded off duty.",
  "permissions": ["tabs", "storage", "alarms", "idle"],
  "host_permissions": ["https://smart-attendance.pro/*"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "BURAQ Tracker", "default_popup": "popup.html" }
}
